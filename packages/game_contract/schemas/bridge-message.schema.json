{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://game-hub.local/schemas/bridge-message/1.0.0",
  "title": "Game Hub Bridge Message v1.0.0",
  "type": "object",
  "required": ["protocol", "protocolVersion", "type", "gameId", "sessionId", "messageId", "timestamp", "payload"],
  "properties": {
    "protocol": { "type": "string", "const": "game-hub" },
    "protocolVersion": { "type": "string", "const": "1.0.0" },
    "type": {
      "type": "string",
      "enum": [
        "GAME_READY",
        "GAME_STARTED",
        "GAME_PAUSED",
        "GAME_RESUMED",
        "GAME_COMPLETED",
        "LEVEL_COMPLETED",
        "SCORE_UPDATED",
        "GAME_ERROR",
        "REQUEST_FULLSCREEN",
        "REQUEST_EXIT",
        "HUB_INIT",
        "PAUSE_GAME",
        "RESUME_GAME",
        "MUTE_AUDIO",
        "UNMUTE_AUDIO",
        "REQUEST_STATE"
      ]
    },
    "gameId": { "type": "string", "minLength": 2, "maxLength": 64 },
    "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "messageId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "timestamp": { "type": "number" },
    "payload": { "type": "object" }
  }
}
