{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://game-hub.local/schemas/game-manifest/2.0.0",
  "title": "Game Hub Manifest v2.0.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "slug",
    "version",
    "metadata",
    "assets",
    "web",
    "mobile",
    "content",
    "features",
    "distribution",
    "integration"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "metadata": {
      "type": "object",
      "required": ["title", "shortDescription", "description", "categories", "defaultLocale", "supportedLocales"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "shortDescription": { "type": "string", "minLength": 1, "maxLength": 300 },
        "description": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "howToPlay": { "type": "string", "maxLength": 3000 },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 40 }
        },
        "developer": { "type": "string", "maxLength": 120 },
        "defaultLocale": { "type": "string", "minLength": 2, "maxLength": 10 },
        "supportedLocales": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 2, "maxLength": 10 }
        }
      }
    },
    "assets": {
      "type": "object",
      "required": ["icon", "thumbnail"],
      "properties": {
        "icon": { "type": "string", "minLength": 1 },
        "thumbnail": { "type": "string", "minLength": 1 },
        "screenshots": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "web": {
      "type": "object",
      "required": ["enabled", "buildVersion", "entrypoint", "buildStrategy", "orientation", "aspectRatio"],
      "properties": {
        "enabled": { "type": "boolean" },
        "artifactUrl": { "type": ["string", "null"] },
        "buildVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
        "entrypoint": { "type": "string", "minLength": 1 },
        "buildStrategy": { "type": "string", "enum": ["javascript", "wasm"] },
        "orientation": { "type": "string", "enum": ["portrait", "landscape", "any"] },
        "aspectRatio": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "number", "minimum": 1 },
            "height": { "type": "number", "minimum": 1 }
          }
        },
        "fullscreen": { "type": "boolean" },
        "backgroundColor": {
          "type": ["string", "null"],
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "supportsTouch": { "type": "boolean" },
        "supportsKeyboard": { "type": "boolean" },
        "supportsOffline": { "type": "boolean" },
        "hubBridgeEnabled": { "type": "boolean" }
      }
    },
    "mobile": {
      "type": "object",
      "required": ["android", "ios"],
      "properties": {
        "android": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "packageId": { "type": ["string", "null"] },
            "storeUrl": { "type": ["string", "null"] },
            "appLink": { "type": ["string", "null"] }
          }
        },
        "ios": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "bundleId": { "type": ["string", "null"] },
            "appStoreId": { "type": ["string", "null"] },
            "storeUrl": { "type": ["string", "null"] },
            "universalLink": { "type": ["string", "null"] }
          }
        }
      }
    },
    "content": {
      "type": "object",
      "required": ["source", "offlineFirst", "syncEnabled"],
      "properties": {
        "source": { "type": "string", "enum": ["bundled", "firebase", "hybrid"] },
        "provider": { "type": ["string", "null"], "enum": ["firestore", "rtdb", "none", null] },
        "projectRef": { "type": ["string", "null"] },
        "remoteMetadataPath": { "type": ["string", "null"] },
        "bundledContentAsset": { "type": ["string", "null"] },
        "bundledContentVersion": { "type": ["string", "null"] },
        "offlineFirst": { "type": "boolean" },
        "syncEnabled": { "type": "boolean" },
        "syncIntervalHours": { "type": "number", "minimum": 1 }
      }
    },
    "features": {
      "type": "object",
      "required": ["localStorage", "firebaseContentSync", "nativeAds", "webAds", "playerAuthentication", "hubBridge"],
      "properties": {
        "localStorage": { "type": "boolean" },
        "firebaseContentSync": { "type": "boolean" },
        "nativeAds": { "type": "boolean" },
        "webAds": { "type": "boolean", "const": false },
        "playerAuthentication": { "type": "boolean" },
        "hubBridge": { "type": "boolean" }
      }
    },
    "distribution": {
      "type": "object",
      "required": ["installPromptEnabled", "installPromptCooldownDays", "allowWebPlay"],
      "properties": {
        "installPromptEnabled": { "type": "boolean" },
        "installPromptCooldownDays": { "type": "integer", "minimum": 0, "maximum": 90 },
        "allowWebPlay": { "type": "boolean", "const": true }
      }
    },
    "integration": {
      "type": "object",
      "required": ["platformPackageVersion", "bridgeProtocolVersion"],
      "properties": {
        "platformPackageVersion": { "type": "string" },
        "bridgeProtocolVersion": { "type": "string" }
      }
    }
  }
}
