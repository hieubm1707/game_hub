/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com http://127.0.0.1:8088 http://127.0.0.1:9099 http://localhost:8088 http://localhost:9099; frame-src 'self' https://*.pages.dev https://*.vercel.app http://127.0.0.1:8090 http://localhost:8090; frame-ancestors 'none';

/admin/*
  X-Robots-Tag: noindex, nofollow
