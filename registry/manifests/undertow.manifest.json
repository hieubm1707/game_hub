  "metadata": {
    "title": "Undertow",
    "shortDescription": "Move one. Move them all. Scandinavian magnetic gravity puzzle.",
    "description": "Undertow is an offline-first magnetic gravity puzzle game. Tilt the board to slide linked marbles and blocks together across Scandinavian-inspired boards through Campaign, Daily Challenge, and Free Play modes.",
    "howToPlay": "Swipe or press the arrow keys to tilt the board in four directions. Every movable piece slides together with gravity until blocked. Guide each marble onto its matching goal cell in as few moves as possible.",
    "categories": [
      "puzzle",
      "logic"
    ],
    "tags": [
      "gravity",
      "magnetic",
      "offline",
      "puzzle",
      "minimalist"
    ],
    "developer": "Cecily Studio",
