  "metadata": {
    "title": "Echo Step",
    "shortDescription": "A spatial logic puzzle about coordinating your three-turn afterglow.",
    "description": "One swipe moves the hero one grid cell while a shadow echo replays your successful moves exactly three turns later. Coordinate Sun and Moon across gates, switches, and time-sensitive circuits in Campaign, Daily Challenge, and Free Play — completely offline-first.",
    "howToPlay": "Swipe, tap direction buttons, or use arrow keys to move the Sun one cell. Your Moon echo replays your successful moves three turns later. Coordinate both onto their goals simultaneously. Blocked moves do not advance time.",
    "categories": [
      "puzzle",
      "logic"
    ],
    "tags": [
      "offline",
      "spatial",
      "time-loop",
      "grid",
      "echo"
    ],
    "developer": "Cecily",
