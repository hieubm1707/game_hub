  "metadata": {
    "title": "PRISMIND — Chromatic Alchemy",
    "shortDescription": "Offline-first visual rule inference puzzle on colored grids.",
    "description": "Read 2–4 visual transformation examples, infer the hidden chromatic rule, and build the target grid. Features a 352-level campaign, Daily Challenge, Free Play, color-blind symbol accessibility, and English/Vietnamese support.",
    "howToPlay": "Study the input-to-output transformation examples, infer the rule, then paint the answer grid to match. Progress is saved locally.",
    "categories": [
      "puzzle",
      "logic",
      "brain"
    ],
    "tags": [
      "offline",
      "puzzle",
      "logic",
      "grid",
      "chromatic",
      "daily"
    ],
    "developer": "Cecily",
    "defaultLocale": "en",
    "supportedLocales": [
      "en",
      "vi"
    ]
  },
  "assets": {
