# Firebase Web SDK Configuration (Public client config - NOT privileged credentials)
# For local development with Firebase Emulator Suite, leave VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-game-hub.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-game-hub
VITE_FIREBASE_APP_ID=1:000000000000:web:demo000000000000
# Optional Firebase App Check reCAPTCHA site key (production only; provider: enterprise | v3)
VITE_FIREBASE_APP_CHECK_SITE_KEY=
VITE_FIREBASE_APP_CHECK_PROVIDER=enterprise
# Optional App Check debug token for localhost dev against a live Firebase project with App Check enforced
# Set to `true` (generates & logs a token in DevTools) or a registered UUID from Firebase Console
VITE_FIREBASE_APP_CHECK_DEBUG_TOKEN=

# Local Firebase Emulator Suite toggle
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8088
VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Trusted Game Artifact Origins (comma-separated origins or HTTPS wildcards allowed in GamePlayer iframe)
VITE_ALLOWED_GAME_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://localhost:8090,http://127.0.0.1:8090,https://*.vercel.app

# Hub Public Metadata
VITE_HUB_TITLE=Game Hub
VITE_HUB_BASE_URL=http://localhost:5173
VITE_CATALOG_CACHE_TTL_MINUTES=60
